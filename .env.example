# Reels Factory- every external key, all OPTIONAL (pipeline degrades gracefully without them).
# Copy to .env; never commit .env.

# --- IBKR (primary market data; TWS or IB Gateway must be running) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497            # 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live
IBKR_CLIENT_ID=17

# --- LLM (strategy extraction, scriptwriting, fact-check; distinct passes) ---
ANTHROPIC_API_KEY=

# --- TTS (optional; falls to bundled piper -> pyttsx3 -> captions-only) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Instagram Graph API (posting + insights; needs IG Professional account linked to a FB page) ---
IG_HIGH_FINANCE_USER_ID=
IG_HIGH_FINANCE_ACCESS_TOKEN=
IG_WANNABE_QUANT_USER_ID=
IG_WANNABE_QUANT_ACCESS_TOKEN=

# --- Optional video-gen / b-roll providers (pluggable; skipped when empty) ---
RUNWAY_API_KEY=
PEXELS_API_KEY=
